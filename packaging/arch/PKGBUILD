# Maintainer: Thomas Reim <reimth@etik.com>
pkgname=ipsec-tools
pkgver=0.9.1
pkgrel=1
pkgdesc="IKEv1 key exchange daemon (racoon) and IPsec utilities — community-maintained Linux continuation"
arch=('x86_64' 'aarch64')
url="https://github.com/rdratlos/racoon-ipsec-tools"
license=('BSD-3-Clause')
depends=('openssl' 'libldap' 'linux-headers' 'pam' 'krb5')
makedepends=('autoconf' 'automake' 'libtool' 'flex' 'bison' 'pkgconf')
install=ipsec-tools.install
# As Racoon is not on AUR build the debug symbol package, too
options=(debug)
backup=('etc/racoon/racoon.conf'
        'etc/ipsec-tools.conf'
        'etc/conf.d/racoon'
        'etc/conf.d/setkey')
# racoon.conf is a *local* source, deliberately not read from inside the
# downloaded release tarball below: that tarball is dpkg-source's native
# Debian source package (also published as this project's GitHub Release
# asset), and debian/source/local-options excludes packaging/ from it --
# it is Debian's own packaging metadata that has no business in a
# from-scratch Debian source tree, and this project's release process
# treats that tarball as frozen/checksum-signed once published, so
# nothing in package() below may assume packaging/arch/* is present
# inside it. ipsec-tools.sysusers/ipsec-tools.tmpfiles already followed
# this same local-source pattern; racoon.conf now does too.
source=("$pkgname-$pkgver.tar.xz::https://github.com/rdratlos/racoon-ipsec-tools/releases/download/v$pkgver/ipsec-tools_$pkgver.tar.xz"
        ipsec-tools.sysusers
        ipsec-tools.tmpfiles
        racoon.conf)
sha256sums=('SKIP'
            '52f3c273e6c2e2cd0d9ee15e48ecdab07496af0b233fde0a59b6e69a02b25bee'
            '4d350c44e28066b89c1faad341b1da6062fe63301116ba72c014119ccff772e5'
            'b0ebdac6c76d6221139b91679ea06f6b1f20edc50dbefe03ecefbc0375ae637b')

build() {
  cd "racoon-ipsec-tools"
  autoreconf -fi
  ./configure \
    --host=x86_64-linux-gnu \
    --build=x86_64-linux-gnu \
    --prefix=/usr \
    --sbindir=/usr/bin \
    --sysconfdir=/etc/racoon \
    --libdir=/usr/lib/ipsec-tools \
    --mandir=\${prefix}/share/man \
    --infodir=\${prefix}/share/info \
    --localstatedir=/var/run \
    --with-environmentdir=/etc/conf.d
  make
}

check() {
  cd "racoon-ipsec-tools"
  make check
}

# `make DESTDIR=... install` now does most of what this function used to
# do by hand (docs/examples/Makefile.am + systemd/Makefile.am +
# src/racoon/{Makefile.am, scripts/Makefile.am}):
#   - /etc/racoon/scripts/{racoon-hook-lib.sh,phase1-up.sh,phase1-down.sh,
#     racoon-dns-detect} (the road-warrior split-DNS/routing hooks) --
#     a real installed component, matching the `script` directive paths
#     documented in doc/admin/split-dns.html.
#   - /etc/racoon/racoon.conf -- a role-agnostic, inert default, but only
#     if that path doesn't already exist; irrelevant for a fresh package
#     build (pkgdir always starts empty) but means a rebuild/reinstall
#     never clobbers a config an admin has since edited. package() below
#     overwrites this generic default with this package's own local
#     racoon.conf source (see source=() above), a privsep-active starter
#     config (same reasoning as debian/racoon.conf's own override -- see
#     that install line's comment below for why).
#   - /etc/racoon/certs/, empty (X.509 is this project's primary
#     authentication path).
#   - /etc/racoon/hooks.conf.sample, alongside where hooks.conf itself
#     goes.
#   - The narrower single-feature reference material (racoon.conf.default,
#     racoon.conf.sample-{natt,plainrsa,gssapi,inherit}, psk.txt.example)
#     under $(docdir)/examples. Since this PKGBUILD's pkgname is
#     "ipsec-tools" -- the same as upstream's own PACKAGE_TARNAME --
#     autotools' default $(docdir) (no --docdir override needed) already
#     resolves to usr/share/doc/ipsec-tools, exactly where this
#     function's own doc-tree installs below (LICENSE, NEWS.md,
#     admin-guide, ...) land.
#   - The roadwarrior client/server configuration templates
#     (roadwarrior/**), separately, under $(templatesdir) -- default
#     usr/share/racoon/templates, no --with-templatesdir override needed
#     -- rather than under docdir: they are this project's documented
#     onboarding path (see racoon.conf.default's own header comment), not
#     optional reading, so they need to survive independently of whatever
#     a given install does with /usr/share/doc.
#   - racoon.service/setkey.service, at whatever $(systemdsystemunitdir)
#     pkg-config's systemd.pc reports -- /usr/lib/systemd/system on Arch,
#     no --with-systemdsystemunitdir override needed. These used to be
#     independently forked copies of debian/racoon.service and
#     debian/ipsec-tools.setkey.service; now there is exactly one
#     upstream unit definition (systemd/racoon.service.in,
#     systemd/setkey.service.in), templated per build with the right
#     binary path and EnvironmentFile= directory.
#   - /etc/conf.d/{racoon,setkey} (build()'s own
#     --with-environmentdir=/etc/conf.d, matching Arch's own
#     conf.d convention rather than upstream's /etc/default default).
# What's left here is genuinely package-specific: Arch config file
# locations ported from debian/ (ipsec-tools.conf, ipsec-tools.d),
# sysusers.d/tmpfiles.d, the usrmerge/var-run adjustments, and doc
# content the autotools install still doesn't cover (split-dns.html,
# the admin guide, the legacy tunnel-example.txt carried over from
# debian/examples).
package() {
  cd "racoon-ipsec-tools"
  make DESTDIR="$pkgdir" install
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 NEWS.md "$pkgdir/usr/share/doc/$pkgname/NEWS.md"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"

  # usrmerge (/usr/sbin) and /var/run tmpfs conflicts
  if [ -d "$pkgdir/usr/sbin" ]; then
    mkdir -p "$pkgdir/usr/bin"
    mv "$pkgdir"/usr/sbin/* "$pkgdir/usr/bin/" 2>/dev/null || true
    rmdir "$pkgdir/usr/sbin"
  fi
  rm -rf "$pkgdir/var/run"

  # Arch-specific config, ported from debian/. psk.txt is deliberately
  # NOT installed here: there is no default to ship at all -- create one
  # from usr/share/doc/ipsec-tools/examples/psk.txt.example if/when a
  # remote block actually needs pre-shared-key or XAuth authentication.
  install -dm755 "$pkgdir/etc/ipsec-tools.d"
  install -Dm644 debian/ipsec-tools.conf "$pkgdir/etc/ipsec-tools.conf"

  # racoon.conf: `make install` above already placed the generic,
  # role-agnostic default (only if the destdir didn't already have one,
  # which it never does for a fresh package() run) -- overwrite it with
  # this package's own privsep-active default instead, same reasoning as
  # debian/racoon.conf's own override: ipsec-tools.sysusers +
  # ipsec-tools.tmpfiles below always create the "racoon" system user and
  # the root:racoon ownership privsep needs, unconditionally, so there is
  # no from-source-install uncertainty to defer to here the way the
  # generic upstream default (docs/examples/racoon.conf.default.in) has
  # to leave open. Sourced from $srcdir, not the extracted tarball --
  # see the source=() array's own comment above for why.
  install -Dm600 "$srcdir/racoon.conf" "$pkgdir/etc/racoon/racoon.conf"
  install -Dm644 doc/admin/split-dns.html "$pkgdir/usr/share/doc/$pkgname/split-dns.html"

  # sysusers.d/tmpfiles.d: still Arch-specific (Debian creates the
  # racoon user via postinst's adduser instead) -- racoon.service/
  # setkey.service and /etc/conf.d/{racoon,setkey} are no longer
  # installed here at all, `make install` above already placed them.
  install -Dm644 "$srcdir/ipsec-tools.sysusers" "$pkgdir/usr/lib/sysusers.d/$pkgname.conf"
  install -Dm644 "$srcdir/ipsec-tools.tmpfiles" "$pkgdir/usr/lib/tmpfiles.d/$pkgname.conf"

  # Doc content the autotools install doesn't cover: the legacy
  # site-to-site tunnel walkthrough carried over from debian/examples,
  # the packaging README, and the admin guide.
  install -Dm644 debian/examples/tunnel-openbsd-to-debian-example.txt \
    "$pkgdir/usr/share/doc/$pkgname/examples/tunnel-example.txt"
  install -Dm644 debian/racoon.README.Debian "$pkgdir/usr/share/doc/$pkgname/README.packaging"
  cp -r docs/admin-guide "$pkgdir/usr/share/doc/$pkgname/admin-guide"
  find "$pkgdir/usr/share/doc/$pkgname/admin-guide" -type f -exec chmod 644 {} +
  find "$pkgdir/usr/share/doc/$pkgname/admin-guide" -type d -exec chmod 755 {} +

  # Kate syntax highlighting for racoon.conf - see misc/kate/README.md
  install -Dm644 misc/kate/racoon.xml \
    "$pkgdir/usr/share/org.kde.syntax-highlighting/syntax/racoon.xml"
}
