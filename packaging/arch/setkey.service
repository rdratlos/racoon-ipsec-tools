[Unit]
Description=Static IPsec SA/SPD from /etc/ipsec-tools.conf
DefaultDependencies=no
Before=sysinit.target
ConditionPathExists=/etc/ipsec-tools.conf

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/conf.d/setkey
ExecStart=/bin/bash -c 'shopt -s nullglob; test "${RUN_SETKEY:-yes}" = "yes" || exit 0; for f in /etc/ipsec-tools.conf /etc/ipsec-tools.d/*.conf; do /usr/bin/setkey -f "$f"; done'
ExecStop=-/usr/bin/setkey -F
ExecStopPost=-/usr/bin/setkey -FP

[Install]
WantedBy=sysinit.target
