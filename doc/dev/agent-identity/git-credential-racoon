#!/bin/sh
# git credential helper: hands git a short-lived token of the agent's app,
# chosen by RACOON_APP_CONF (for example /etc/racoon-opencode/app.json).
[ "$1" = get ] || exit 0
: "${RACOON_APP_CONF:?git-credential-racoon: RACOON_APP_CONF is not set}"
tok=$(sudo -n -u ghapp /usr/local/libexec/mint-token "$RACOON_APP_CONF") || exit 1
printf 'username=x-access-token\npassword=%s\n' "$tok"
