#!/usr/bin/make -f

export DH_OPTIONS

# These are used for cross-compiling and for saving the configure script
DEB_HOST_GNU_TYPE   ?= $(shell dpkg-architecture -qDEB_HOST_GNU_TYPE)
DEB_HOST_ARCH   ?= $(shell dpkg-architecture -qDEB_HOST_ARCH)
DEB_BUILD_GNU_TYPE  ?= $(shell dpkg-architecture -qDEB_BUILD_GNU_TYPE)

# Debian build environment variables (from deb-buildoptions(7)):
# DEB_BUILD_OPTIONS: controls parallelism, debug symbols, etc.
#   Examples: "parallel=N", "noopt", "nodde", "debug", "nosystemd"
export DEB_BUILD_OPTIONS

# DEB_HOST_ARCH: target architecture from dpkg-architecture
export DEB_HOST_ARCH

# DEB_BUILD_ARCH: build architecture from dpkg-architecture
DEB_BUILD_ARCH  ?= $(shell dpkg-architecture -qDEB_BUILD_ARCH)
export DEB_BUILD_ARCH

# DEB_BUILD_GNU_TYPE / DEB_HOST_GNU_TYPE: GNU triplets
export DEB_BUILD_GNU_TYPE
export DEB_HOST_GNU_TYPE

# DEB_CONFIGURE_EXTRA_OPTS: allows passing extra configure flags from the
# environment or command line.  This is the standard Debian mechanism for
# overriding build options without editing debian/rules.
DEB_CONFIGURE_EXTRA_OPTS ?=

CPPFLAGS:=$(shell dpkg-buildflags --get CPPFLAGS)
CFLAGS:=$(shell dpkg-buildflags --get CFLAGS)
CXXFLAGS:=$(shell dpkg-buildflags --get CXXFLAGS)
LDFLAGS:=$(shell dpkg-buildflags --get LDFLAGS)

# Kernel backend selection for kernelpaws framework:
# KERNELPAWS_BACKEND: select the kernel IPsec abstraction backend.
#   Values: "xfrm" (XFRM netlink, default), "pfkeyv2" (legacy PF_KEYv2)
#   Set via environment: KERNELPAWS_BACKEND=pfkeyv2 dpkg-buildpackage ...
KERNELPAWS_BACKEND ?= xfrm

# Optional code-coverage build (for CI only, NOT for official Debian builds).
# Trigger with:
#   dpkg-buildpackage -us -uc -b ENABLE_COVERAGE=1
# or in CI:
#   DEB_BUILD_OPTIONS= ENABLE_COVERAGE=1 dpkg-buildpackage -us -uc -b
ifeq ($(ENABLE_COVERAGE),1)
COV_FLAGS=--enable-coverage
else
COV_FLAGS=
endif

# kernelpaws backend selection maps to configure flags.
# --enable-xfrm selects the XFRM netlink backend (HAVE_XFRM defined).
# Omitting --enable-xfrm falls back to the legacy PF_KEYv2 backend.
ifeq ($(KERNELPAWS_BACKEND),xfrm)
KERNELPAWS_FLAGS=--enable-xfrm
else
KERNELPAWS_FLAGS=
endif

# Respect DEB_BUILD_OPTIONS=nocheck to skip test suite.
ifeq ($(filter nocheck,$(DEB_BUILD_OPTIONS)),)
WITH_TESTS=--enable-tests
else
WITH_TESTS=
endif

%:
	dh $@

override_dh_auto_configure:
	CPPFLAGS="$(CPPFLAGS)" LDFLAGS="$(LDFLAGS)" CFLAGS="$(CFLAGS)" \
					./configure --verbose \
					--host=$(DEB_HOST_GNU_TYPE) \
					--build=$(DEB_BUILD_GNU_TYPE) \
					--prefix=/usr \
					--sysconfdir=/etc/racoon \
					--libdir=/usr/lib/ipsec-tools \
					--mandir=\$${prefix}/share/man \
					--infodir=\$${prefix}/share/info \
					--localstatedir=/var/run \
					--enable-shared \
					--disable-static \
					--enable-frag \
					--enable-gssapi \
					--enable-hybrid \
					--with-libldap \
					--enable-dpd \
					--enable-adminport \
					--with-kernel-headers=/usr/include \
					--with-libpam \
					--without-readline \
					--disable-security-context \
					--enable-natt \
					$(KERNELPAWS_FLAGS) \
					$(WITH_TESTS) \
					$(COV_FLAGS) \
					$(DEB_CONFIGURE_EXTRA_OPTS)

override_dh_clean:
	dh_testdir
	dh_auto_clean
	dh_clean
	# Remove this after make clean as it upsets git-buildpackage
	# make clean will invoke configure!!
	- rm -f config.log

override_dh_install:
	dh_install
	mkdir -p debian/racoon/var/lib/racoon
	install -m 755 debian/racoon-tool.pl \
	    debian/racoon/usr/sbin/racoon-tool
	install -D -m 600 src/racoon/samples/psk.txt.sample \
	    debian/racoon/etc/racoon/psk.txt
	install -m 644 debian/racoon-tool.conf \
	    debian/racoon/etc/racoon
	install -m 644 debian/racoon.conf \
	    debian/racoon/etc/racoon/racoon.conf
	mkdir -p debian/ipsec-tools/etc
	install -m 755 debian/ipsec-tools.conf \
	    debian/ipsec-tools/etc/ipsec-tools.conf

override_dh_installsystemd:
	# setkey is a one-shot service that racoon.service pulls in via
	# Requires=/After=; it must not be independently enabled at boot.
	dh_installsystemd -p ipsec-tools --name=setkey --no-enable
	dh_installsystemd --remaining-packages

override_dh_installinit:
	dh_installinit -p ipsec-tools --name=setkey --no-start
	dh_installinit --remaining-packages

override_dh_installchangelogs:
	dh_installchangelogs NEWS.md

override_dh_installexamples:
	dh_installexamples -pracoon -X.in src/racoon/samples
	dh_installexamples

override_dh_installman:
	dh_installman
	dh_installman -pracoon debian/racoon-tool.8 debian/racoon-tool.conf.5

override_dh_makeshlibs:
	dh_makeshlibs -n

