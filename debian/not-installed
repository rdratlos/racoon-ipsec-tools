# docs/examples/Makefile.am's generic `make install` now installs a
# default racoon.conf (into $(sysconfdir), via src/racoon's own
# adjoining install-data-local) and a documentation examples tree of its
# own. Debian intentionally continues to ship its own equivalents by
# other means -- debian/racoon.conf via override_dh_install, and
# override_dh_installexamples's own glob of docs/examples/* -- rather
# than these DESTDIR-staged copies, which also land under
# usr/share/doc/ipsec-tools/ (the upstream PACKAGE_TARNAME) rather than
# this package's own usr/share/doc/racoon/. Reconciling the two
# (e.g. via --docdir=/usr/share/doc/racoon) is left to a follow-up,
# distribution-specific task; until then these are deliberately listed
# here so dh_missing does not fail the build over them.
#
# The roadwarrior client/server templates used to be part of this same
# list (they land under $(examplesdir) = $(docdir)/examples too, by the
# same PACKAGE_TARNAME mismatch) -- no longer: they now install to
# $(templatesdir) instead (usr/share/racoon/templates, package-name-
# agnostic by construction), which debian/racoon.install claims
# directly. Nothing under templatesdir belongs in this file.
etc/racoon/racoon.conf
etc/racoon/hooks.conf.sample
usr/share/doc/ipsec-tools/examples/psk.txt.example
usr/share/doc/ipsec-tools/examples/racoon.conf.default
usr/share/doc/ipsec-tools/examples/racoon.conf.sample-gssapi
usr/share/doc/ipsec-tools/examples/racoon.conf.sample-inherit
usr/share/doc/ipsec-tools/examples/racoon.conf.sample-natt
usr/share/doc/ipsec-tools/examples/racoon.conf.sample-plainrsa

# systemd/Makefile.am's `make install` also installs /etc/default/
# {racoon,setkey} of its own (see configure.ac's --with-environmentdir).
# racoon.service/setkey.service do NOT need an entry here any more --
# debian/racoon.install and debian/ipsec-tools.install now claim
# usr/lib/systemd/system/{racoon,setkey}.service straight out of
# debian/tmp instead of debian/rules carrying its own forked copies;
# verified live (dpkg-buildpackage -us -uc -b) that dh_installsystemd
# finds and processes them there exactly as it would a local
# debian/<pkg>.service file, generating the same enable/disable
# maintainer-script logic.
#
# /etc/default/racoon got the same treatment as of the racoon.service
# unification above: debian/racoon.install now claims it straight out of
# debian/tmp too (a real shipped conffile, dh_installdeb's usual
# automatic /etc/ detection -- same as etc/racoon/racoon.conf already
# gets, no explicit debian/racoon.conffiles needed), and
# debian/racoon.postinst no longer generates it. /etc/default/setkey
# could not get the same treatment yet: it still comes from
# debian/ipsec-tools.setkey.default via override_dh_installinit, which
# disagrees with systemd/setkey.envfile's RUN_SETKEY default (commented
# out/inactive here vs. active there) -- reconciling that content, not
# just the install mechanism, needs its own decision and is left to a
# follow-up.
etc/default/setkey
