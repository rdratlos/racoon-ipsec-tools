# docs/examples/Makefile.am's generic `make install` now installs a
# default racoon.conf (into $(sysconfdir), via src/racoon's own
# adjoining install-data-local) and a documentation examples tree of its
# own. Debian intentionally continues to ship its own equivalents by
# other means -- debian/racoon.conf via override_dh_install, and
# override_dh_installexamples's own glob of docs/examples/* -- rather
# than these DESTDIR-staged copies, which also land under
# usr/share/doc/ipsec-tools/ (the upstream PACKAGE_TARNAME) rather than
# this package's own usr/share/doc/racoon/. Reconciling the two
# (e.g. via --docdir=/usr/share/doc/racoon) is left to a follow-up,
# distribution-specific task; until then these are deliberately listed
# here so dh_missing does not fail the build over them.
etc/racoon/racoon.conf
etc/racoon/hooks.conf.sample
usr/share/doc/ipsec-tools/examples/psk.txt.example
usr/share/doc/ipsec-tools/examples/racoon.conf.default
usr/share/doc/ipsec-tools/examples/racoon.conf.sample-gssapi
usr/share/doc/ipsec-tools/examples/racoon.conf.sample-inherit
usr/share/doc/ipsec-tools/examples/racoon.conf.sample-natt
usr/share/doc/ipsec-tools/examples/racoon.conf.sample-plainrsa
usr/share/doc/ipsec-tools/examples/roadwarrior/README
usr/share/doc/ipsec-tools/examples/roadwarrior/client/phase1-down.sh
usr/share/doc/ipsec-tools/examples/roadwarrior/client/phase1-up.sh
usr/share/doc/ipsec-tools/examples/roadwarrior/client/racoon.conf
usr/share/doc/ipsec-tools/examples/roadwarrior/server/racoon.conf
