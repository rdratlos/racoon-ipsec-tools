# racoon.conf - GSS-API (Kerberos) Authentication Feature Example
#
# Focused, single-feature example: authenticating phase 1 via GSS-API
# (in practice, Kerberos 5) instead of certificates or pre-shared keys --
# useful in an existing Kerberos realm (e.g. Active Directory) where hosts
# already hold machine credentials and you would rather reuse those than
# provision a separate PKI.  Requires racoon built with --enable-gssapi
# (see doc/README.gssapi in the source tree for the implementation
# background and its Heimdal-specific credential-acquisition notes).
#
# Key design decisions:
#   - gssapi_krb as the phase 1 authentication_method: this is what
#     actually selects GSS-API/Kerberos rather than certificates or PSK.
#   - gss_id: the Kerberos principal racoon acquires and presents as its
#     GSS endpoint identity. If omitted, racoon defaults to
#     "ike/<hostname>", matching the "special credentials" convention
#     described in doc/README.gssapi (analogous to "host/<fqdn>" used by
#     login-authentication daemons). This principal must already be
#     extracted into the local keytab from the KDC
#     (`ktutil` / `kadmin ext_keytab` depending on your Kerberos
#     implementation) -- racoon does not provision Kerberos credentials
#     itself, only consumes them.
#   - No certificate_type/path certificate directives: GSS-API
#     authentication does not use racoon's certificate machinery at all.

# Uncomment if interoperating with a peer running a pre-2001-vintage
# racoon that (incorrectly) encoded the GSS-API identifier attribute as
# ISO-Latin-1 instead of UTF-8. Not needed against any current
# implementation. Must appear before any "remote" block.
#gss_id_enc latin1;

remote anonymous {
    # GSS-API/Kerberos is only defined for Main Mode in this
    # implementation.
    exchange_mode main;

    lifetime time 24 hour;

    proposal {
        encryption_algorithm aes 256;
        hash_algorithm sha256;

        # Selects GSS-API (Kerberos) authentication for this proposal.
        authentication_method gssapi_krb;

        # The Kerberos principal to acquire and present as this host's
        # GSS endpoint identity. Uncomment and set explicitly if the
        # default "ike/<hostname>" does not match your KDC's principal
        # naming, or list the principals already in your keytab with
        # `ktutil` (or your Kerberos implementation's equivalent) if
        # you are not sure what is available.
        #gss_id "ike/vpn-gateway.example.com";

        dh_group 14;
    }
}

sainfo anonymous {
    lifetime time 2 hour;
    encryption_algorithm aes 256;
    authentication_algorithm hmac_sha256, hmac_sha1;
    compression_algorithm deflate;
}
