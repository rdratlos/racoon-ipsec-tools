# Debian packaging build artifacts (dpkg-buildpackage/debhelper).
# debian/racoon/ and debian/ipsec-tools/ are the per-binary-package
# staging directories debhelper creates from the two packages this
# source tree builds (see debian/control) -- named for the packages,
# not a generic pattern.
/debian/.debhelper/
/debian/tmp/
/debian/racoon/
/debian/ipsec-tools/
/debian/files
/debian/*.substvars
/debian/*.debhelper.log
/debian/*.debhelper
/debian/debhelper-build-stamp
/debian/autoreconf.after
/debian/autoreconf.before

